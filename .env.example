# GEMINI_API_KEY: Required for Google Gemini 2.0 AI API calls (Web Search Grounding, Multimodal Vision, Threat AI).
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey (Key format starts with AIzaSy...)
# If left empty or invalid, CyberGuard runs using its in-house offline neural intelligence engine.
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP settings for real OTP email dispatch (e.g. Gmail App SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# Payee settling bank details for direct card simulated route
PAYEE_ACCOUNT_NUMBER="912345678901"
PAYEE_BANK_IFSC="SBIN0000321"
PAYEE_BANK_NAME="State Bank of India"
PAYEE_NAME="Hemant Kaushal"

# Razorpay credentials (if not configured, the app falls back to beautiful sandboxed simulation mode)
RAZORPAY_KEY_ID="rzp_test_yourKeyHere"
RAZORPAY_KEY_SECRET="yourSecretHere"

# Secure Cryptographic Key for Database Encryption-at-Rest
DB_ENCRYPTION_SECRET="super-secure-cryptographic-salt-or-key-here"

# Supabase Database Settings
SUPABASE_URL="https://uggcnrysnqxvuemjapwn.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

VITE_SUPABASE_URL="https://uggcnrysnqxvuemjapwn.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
